QT_QPA_PLATFORM=linuxfb:fb=/dev/fb0:rotation=0
QT_QPA_FONTDIR=/usr/share/fonts/cantarell
QT_QPA_FB_NO_LIBINPUT=1
QT_QPA_EVDEV_TOUCHSCREEN_PARAMETERS=rotate=180
XDG_RUNTIME_DIR=/run/ausweisapp
HOME=/var/ausweisapp
XDG_CACHE_HOME=/var/ausweisapp/cache
XDG_CONFIG_HOME=/var/ausweisapp/config
XDG_DATA_HOME=/var/ausweisapp/data
XDG_STATE_HOME=/var/ausweisapp/state
XDG_CONFIG_DIRS=/etc
QV4_FORCE_INTERPRETER=1
PORT=24727
