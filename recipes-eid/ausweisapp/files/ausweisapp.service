[Unit]
Description=AusweisApp service
Conflicts=getty@tty1.service
DefaultDependencies=no

[Service]
DynamicUser=yes
SupplementaryGroups=ausweisapp pcscd video input
BindPaths=/var/ausweisapp:/var/lib/ausweisapp
ReadWritePaths=/var/ausweisapp
StateDirectory=ausweisapp
RuntimeDirectory=ausweisapp
RuntimeDirectoryMode=0750
EnvironmentFile=/etc/AusweisApp/ausweisapp.env
ExecStart=/usr/bin/AusweisApp --port "${PORT}" --no-logfile
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
